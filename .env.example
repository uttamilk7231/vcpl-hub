# VCPL Hub environment variables
#
# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
DATA_DIR=./data
BASE_URL=https://vcpl-hub.onrender.com
COOKIE_SECURE=1
SESSION_TTL_HOURS=168

# --- Database (Neon Postgres) ---
# Use NEON_DATABASE_URL, or DATABASE_URL if you prefer another Postgres.
NEON_DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# --- SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=swamiuttam93@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=swamiuttam93@gmail.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT=https://vcpl-hub.onrender.com/api/auth/google/callback

# --- GitHub OAuth (optional; used to enable Sign in with GitHub) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT=https://vcpl-hub.onrender.com/api/auth/github/callback

# --- Optional tuning ---
# BACKUP_INTERVAL_MIN=15
# BACKUP_KEEP=14
# REPORT_DAY=1
# REPORT_HOUR=9
# APP_VERSION=1.0.0